tion: number): void {\" line25=\"        queue.push(new NotificationMessage(type, icon, message, duration));\" line26=\"\" line27=\"        if (!isShowing) {\" line28=\"            displayNextNotification();\" line29=\"        }\" line30=\"    }\" line31=\"\" line32=\"    function displayNextNotification(): void {\" line33=\"        if (queue.length === 0) {\" line34=\"            isShowing = false;\" line35=\"            return;\" line36=\"        }\" line37=\"\" line38=\"        isShowing = true;\" line39=\"        let current = queue.shift();\" line40=\"\" line41=\"        // Create a banner container sprite\" line42=\"        let banner = sprites.create(image.create(140, 24), SpriteKind.Player);\" line43=\"        banner.x = 80; // Centered horizontally\" line44=\"        banner.y = -20; // Start hidden off-screen at the top\" line45=\"        banner.z = 100; // Ensure it renders on top of all other game elements\" line46=\"\" line47=\"        // Set background color based on notification type\" line48=\"        let bgColor = 9; // Default Blue (Info)\" line49=\"        if (current.type === NotificationType.Success) {\" line50=\"            bgColor = 7; // Green\" line51=\"        } else if (current.type === NotificationType.Warning) {\" line52=\"            bgColor = 2; // Red/Orange\" line53=\"        }\" line54=\"\" line55=\"        // Draw the notification look\" line56=\"        banner.image.fill(bgColor);\" line57=\"        banner.image.drawRect(0, 0, 140, 24, 15);\" line58=\"        banner.image.drawImage(current.icon, 4, 4);\" line59=\"        banner.image.print(current.text, 24, 8, 15);\" line60=\"\" line61=\"        // Run the slide and timer animation in parallel so it doesn't freeze game logic\" line62=\"        control.runInParallel(function () {\" line63=\"            // 1. Slide down animation\" line64=\"            let targetY = 16;\" line65=\"            while (banner.y &lt; targetY) {\" line66=\"                banner.y += 2;\" line67=\"                pause(15);\" line68=\"            }\" line69=\"            banner.y = targetY; // Snap to exact position\" line70=\"\" line71=\"            // 2. Wait for the specified duration (convert seconds to milliseconds)\" line72=\"            pause(current.duration * 1000);\" line73=\"\" line74=\"            // 3. Slide up animation\" line75=\"            while (banner.y &gt; -20) {\" line76=\"                banner.y -= 2;\" line77=\"                pause(15);\" line78=\"            }\" line79=\"\" line80=\"            // Cleanup and move to the next item in the queue\" line81=\"            banner.destroy();\" line82=\"            displayNextNotification();\" line83=\"        });\" line84=\"    }\" line85=\"}\" numlines=\"86\"></mutation></block></statement></block></xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":209,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1792548117274,"editorVersion":"4.1.25","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>","main.ts":" ","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Extensions\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1792548746839}