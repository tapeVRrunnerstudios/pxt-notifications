<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="_%EwfPuFS;jKkv)tN,l=" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="au8j]?kMVbwI}mddngjq"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace notifications {" line1="" line2="    export enum NotificationType {" line3="        //% block=&quot;Info&quot;" line4="        Info," line5="        //% block=&quot;Success&quot;" line6="        Success," line7="        //% block=&quot;Warning&quot;" line8="        Warning" line9="    }" line10="" line11="    class NotificationMessage {" line12="        constructor(public type: NotificationType, public icon: Image, public text: string, public duration: number) { }" line13="    }" line14="" line15="    let queue: NotificationMessage[] = [];" line16="    let isShowing = false;" line17="" line18="    /**" line19="     * Show a popup notification with an icon, message, and display duration" line20="     */" line21="    //% block=&quot;show notification type %type|icon %icon|message %message|duration (sec) %duration&quot;" line22="    //% icon.shadow=spriteimage" line23="    //% duration.defl=2" line24="    export function showNotification(type: NotificationType, icon: Image, message: string, duration: number): void {" line25="        queue.push(new NotificationMessage(type, icon, message, duration));" line26="" line27="        if (!isShowing) {" line28="            displayNextNotification();" line29="        }" line30="    }" line31="" line32="    function displayNextNotification(): void {" line33="        if (queue.length === 0) {" line34="            isShowing = false;" line35="            return;" line36="        }" line37="" line38="        isShowing = true;" line39="        let current = queue.shift();" line40="" line41="        // Create a banner container sprite" line42="        let banner = sprites.create(image.create(140, 24), SpriteKind.Player);" line43="        banner.x = 80; // Centered horizontally" line44="        banner.y = -20; // Start hidden off-screen at the top" line45="        banner.z = 100; // Ensure it renders on top of all other game elements" line46="" line47="        // Set background color based on notification type" line48="        let bgColor = 9; // Default Blue (Info)" line49="        if (current.type === NotificationType.Success) {" line50="            bgColor = 7; // Green" line51="        } else if (current.type === NotificationType.Warning) {" line52="            bgColor = 2; // Red/Orange" line53="        }" line54="" line55="        // Draw the notification look" line56="        banner.image.fill(bgColor);" line57="        banner.image.drawRect(0, 0, 140, 24, 15);" line58="        banner.image.drawImage(current.icon, 4, 4);" line59="        banner.image.print(current.text, 24, 8, 15);" line60="" line61="        // Run the slide and timer animation in parallel so it doesn't freeze game logic" line62="        control.runInParallel(function () {" line63="            // 1. Slide down animation" line64="            let targetY = 16;" line65="            while (banner.y &lt; targetY) {" line66="                banner.y += 2;" line67="                pause(15);" line68="            }" line69="            banner.y = targetY; // Snap to exact position" line70="" line71="            // 2. Wait for the specified duration (convert seconds to milliseconds)" line72="            pause(current.duration * 1000);" line73="" line74="            // 3. Slide up animation" line75="            while (banner.y &gt; -20) {" line76="                banner.y -= 2;" line77="                pause(15);" line78="            }" line79="" line80="            // Cleanup and move to the next item in the queue" line81="            banner.destroy();" line82="            displayNextNotification();" line83="        });" line84="    }" line85="}" numlines="86"></mutation></block></statement></block></xml>